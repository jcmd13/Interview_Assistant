# Trotski Configuration Example
# Note: This project now uses Ollama instead of OpenAI API keys!

# ==============================================
# OLLAMA CONFIGURATION
# ==============================================
# Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Primary model for question detection and answer generation
# Options: gpt-oss:120b-cloud, phi3.5:3.8b, llama3.2:1b, qwen2.5:1.5b, gemma2:2b, mistral
# OLLAMA_MODEL=gpt-oss:120b-cloud

# ==============================================
# SERVER CONFIGURATION
# ==============================================
# Server host and port
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8123

# ==============================================
# WHISPER CONFIGURATION
# ==============================================
# Whisper model size (tiny, base, small, medium, large)
# Smaller = faster, Larger = more accurate
# WHISPER_MODEL=tiny

# Compute type (int8, float16, float32)
# int8 = fastest, float32 = most accurate
# WHISPER_COMPUTE_TYPE=int8

# ==============================================
# AUDIO PROCESSING
# ==============================================
# Audio sample rate (16000 recommended)
# SAMPLE_RATE=16000

# Audio processing window (seconds)
# WINDOW_SECONDS=6.0

# Hop between windows (seconds)
# HOP_SECONDS=0.8

# Minimum energy threshold
# ENERGY_GATE=1e-4

# ==============================================
# LLM BEHAVIOR
# ==============================================
# Enable/disable LLM features
# LLM_ENABLED=true

# Technical interview mode (optimizes for tech questions)
# TECH_INTERVIEW_MODE=true

# Response persona (candidate, assistant, neutral)
# PERSONA=candidate

# Context mode (full, window, headtail)
# CONTEXT_MODE=full

# Maximum output tokens
# MAX_OUTPUT_TOKENS=400

# ==============================================
# RATE LIMITING
# ==============================================
# Minimum gap between LLM responses (seconds)
# LLM_MIN_GAP_SEC=0.5

# Maximum answers per minute
# ANSWERS_PER_MIN=15

# Maximum concurrent LLM requests
# MAX_CONCURRENT_LLM=3

# ==============================================
# DEBUG & LOGGING
# ==============================================
# Enable debug output
# DEBUG=true

# Verbose buffer logging
# VERBOSE_BUFFER=false

# ==============================================
# NOTES
# ==============================================
# 1. All settings above are optional - the server has sensible defaults
# 2. Uncomment and modify any setting you want to change
# 3. Make sure Ollama is running: `ollama serve`
# 4. Pull your chosen model: `ollama pull gpt-oss:120b-cloud`
# 5. No API keys required! 🎉